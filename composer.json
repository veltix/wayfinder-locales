{
    "name": "veltix/wayfinder-locales",
    "description": "Multilingual route + translation generation extending Laravel Wayfinder.",
    "type": "library",
    "keywords": ["laravel", "wayfinder", "i18n", "typescript", "routes", "localization"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/wayfinder": "^0.1.14 || dev-next",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Veltix\\WayfinderLocales\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Veltix\\WayfinderLocales\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Veltix\\WayfinderLocales\\WayfinderI18nServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
