{
    "name": "veltix/wayfinder-locales",
    "description": "Localized route URLs and TypeScript translation catalogs for Laravel Wayfinder (next branch).",
    "type": "library",
    "keywords": [
        "laravel",
        "wayfinder",
        "i18n",
        "typescript",
        "routes",
        "localization"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ranger": "^0.2.4 || ^0.3.0 || ^0.4.0 || ^0.5.0",
        "laravel/wayfinder": "dev-next"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.1|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Veltix\\WayfinderLocales\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Veltix\\WayfinderLocales\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Veltix\\WayfinderLocales\\WayfinderLocalesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
